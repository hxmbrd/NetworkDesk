[Unit]
Description=NetworkDesk SNMP polling (read only)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/glpi
ExecStart=/usr/bin/php /var/www/html/glpi/plugins/networkdesk/bin/poll-snmp.php
TimeoutStartSec=180s
StandardOutput=journal
StandardError=journal
